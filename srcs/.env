# Domain name (subject-ի պահանջ. <login>.42.fr)
DOMAIN_NAME=vapoghos.42.fr

# MariaDB — ոչ-գաղտնի կոնֆիգուրացիա
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user

# WordPress admin — username-ը ՉԻ ԿԱՐՈՂ պարունակել admin/administrator
WP_ADMIN_USER=supervisor
WP_ADMIN_EMAIL=admin@vapoghos.42.fr

# WordPress-ի երկրորդ (ոչ-admin) user-ը
WP_USER=inception
WP_USER_EMAIL=inception@vapoghos.42.fr

# Website title
WP_TITLE=Inception

# FTP
FTP_USER=ftpuser
